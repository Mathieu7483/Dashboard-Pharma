# Copy to .env and fill in. NEVER commit the real .env file.

# development (default) | production
APP_ENV=development

# --- Secrets (REQUIRED in production, >= 32 chars) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Access token lifetime in minutes
JWT_EXPIRES_MINUTES=15

# --- First admin account (created only if it does not exist yet) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Required in production. In development, a random one is generated and printed once.
ADMIN_PASSWORD=

# --- Access control ---
# Public self-registration (POST /auth/register). Keep false: admins create accounts.
ALLOW_PUBLIC_REGISTRATION=false
# Comma-separated browser origins allowed by CORS (empty = same origin only in production)
CORS_ORIGINS=

# --- Database (optional, defaults to Server/database/database.sqlite) ---
# DATABASE_URL=sqlite:////app/Server/database/database.sqlite

# --- Development only ---
# FLASK_DEBUG=true
# SEED_ON_STARTUP=true
# SEED_DEMO_USERS=true
# DEMO_USER_PASSWORD=choose-a-dev-password
